          },
          "info": {
            "100": "#EAF1F6",
            "500": "#355D78",
            "700": "#25364B"
          }
        },
        "fontSize": {
          "display": "40px",
          "pageTitle": "32px",
          "sectionTitle": "22px",
          "panelTitle": "18px",
          "cardTitle": "14px",
          "body": "14px",
          "comfortableBody": "15px",
          "compactBody": "12px",
          "controlLabel": "13px",
          "metadata": "11px",
          "eyebrow": "10px"
        },
        "space": {
          "4": "4px",
          "8": "8px",
          "12": "12px",
          "16": "16px",
          "20": "20px",
          "24": "24px",
          "32": "32px",
          "40": "40px",
          "48": "48px",
          "64": "64px"
        },
        "radius": {
          "control": "8px",
          "card": "12px",
          "composer": "16px",
          "modal": "16px",
          "badge": "6px",
          "pill": "9999px"
        },
        "duration": {
          "fast": "140ms",
          "standard": "200ms"
        }
      }
    },
    "semantic": {
      "color": {
        "background": {
          "canvas": { "operations-dark": "#101719", "studio-light": "#F8F6F1" },
          "nav": { "operations-dark": "#131C1F", "studio-light": "#F1EFE7" },
          "page": { "operations-dark": "#101719", "studio-light": "#F8F6F1" }
        },
        "surface": {
          "default": { "operations-dark": "#192225", "studio-light": "#FFFEFA" },
          "raised": { "operations-dark": "#202C2F", "studio-light": "#FFFFFF" },
          "hover": { "operations-dark": "#253337", "studio-light": "#F3F3EB" },
          "selected": { "operations-dark": "#25392E", "studio-light": "#E8EEE2" },
          "guidance": { "operations-dark": "#1B2528", "studio-light": "#ECEEDE" }
        },
        "border": {
          "subtle": { "operations-dark": "#2B383A", "studio-light": "#E3E2D8" },
          "default": { "operations-dark": "#3A4D4A", "studio-light": "#B5BCAF" },
          "strong": { "operations-dark": "#4A5D5A", "studio-light": "#B5BCAF" },
          "selected": { "operations-dark": "#B6ED82", "studio-light": "#3D6650" },
          "error": { "operations-dark": "#F3A5AC", "studio-light": "#A5353F" },
          "focus": { "operations-dark": "#B6ED82", "studio-light": "#3D6650" }
        },
        "text": {
          "primary": { "operations-dark": "#E7EEEB", "studio-light": "#303B34" },
          "secondary": { "operations-dark": "#B2C0BB", "studio-light": "#626D60" },
          "muted": { "operations-dark": "#8FA49D", "studio-light": "#727A6B" },
          "inverse": { "operations-dark": "#17271C", "studio-light": "#FFFFFF" },
          "guidance": { "operations-dark": "#D9E6DB", "studio-light": "#536247" }
        },
        "action": {
          "primary": {
            "background": { "operations-dark": "#B6ED82", "studio-light": "#3D6650" },
            "backgroundHover": { "operations-dark": "#C8F49E", "studio-light": "#315540" },
            "backgroundPressed": { "operations-dark": "#9FD66B", "studio-light": "#274735" },
            "text": { "operations-dark": "#17271C", "studio-light": "#FFFFFF" }
          },
          "secondary": {
            "background": { "operations-dark": "#192225", "studio-light": "#FFFEFA" },
            "text": { "operations-dark": "#E7EEEB", "studio-light": "#303B34" }
          }
        },
        "status": {
          "success": {
            "foreground": { "operations-dark": "#A8DDB7", "studio-light": "#286346" },
            "background": { "operations-dark": "#20372B", "studio-light": "#E7F1E8" }
          },
          "warning": {
            "foreground": { "operations-dark": "#F6BC85", "studio-light": "#8C5C18" },
            "background": { "operations-dark": "#4A3225", "studio-light": "#FFF3DB" }
          },
          "danger": {
            "foreground": { "operations-dark": "#F3A5AC", "studio-light": "#A5353F" },
            "background": { "operations-dark": "#45282E", "studio-light": "#FBECEF" }
          },
          "info": {
            "foreground": { "operations-dark": "#A7C8F3", "studio-light": "#355D78" },
            "background": { "operations-dark": "#25364B", "studio-light": "#EAF1F6" }
          }
        },
        "focus": {
          "ring": { "operations-dark": "#B6ED82", "studio-light": "#3D6650" }
        },
        "ai": {
          "surface": { "operations-dark": "#1A2427", "studio-light": "#F3F3EB" },
          "messageUser": { "operations-dark": "#25392E", "studio-light": "#E8EEE2" },
          "messageAssistant": { "operations-dark": "#132026", "studio-light": "#FFFFFF" }
        }
      }
    },
    "component": {
      "button": {
        "primary": {
          "background": { "default": "color.action.primary.background", "hover": "color.action.primary.backgroundHover", "pressed": "color.action.primary.backgroundPressed", "disabled": "color.border.subtle" },
          "text": "color.text.inverse"
        },
        "secondary": {
          "background": "color.surface.default",
          "border": "color.border.default",
          "text": "color.text.primary"
        },
        "tertiary": {
          "background": "transparent",
          "text": "color.text.secondary"
        },
        "destructive": {
          "background": "color.status.danger.background",
          "text": "color.status.danger.foreground"
        }
      },
      "card": {
        "background": "color.surface.default",
        "border": "color.border.subtle",
        "borderSelected": "color.border.selected",
        "hover": "color.surface.hover"
      },
      "input": {
        "background": "color.surface.raised",
        "border": "color.border.subtle",
        "borderFocus": "color.focus.ring",
        "text": "color.text.primary",
        "placeholder": "color.text.muted"
      },
      "nav": {
        "background": "color.background.nav",
        "itemBackground": "transparent",
        "itemBackgroundSelected": "color.surface.selected"
      },
      "assistant": {
        "background": "color.ai.surface",
        "userBubble": "color.ai.messageUser",
        "assistantBubble": "color.ai.messageAssistant"
      }
    }
  }
}
