        "palette": {
          "charcoal": {
            "900": "#101719",
            "800": "#131C1F",
            "700": "#192225",
            "600": "#202C2F",
            "500": "#253337",
            "400": "#25392E"
          },
          "forest": {
            "900": "#274735",
            "800": "#315540",
            "700": "#3D6650",
            "600": "#536247"
          },
          "lime": {
            "500": "#B6ED82",
            "600": "#C8F49E",
            "700": "#9FD66B"
          },
          "sage": {
            "100": "#E8EEE2",
            "200": "#ECEEDE"
          },
          "warm": {
            "100": "#F8F6F1",
            "200": "#F1EFE7",
            "300": "#F3F3EB",
            "400": "#E3E2D8"
          },
          "success": {
            "100": "#E7F1E8",
            "500": "#286346",
